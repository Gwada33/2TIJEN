# ---------------------------------------------------------------
# Copie ce fichier en « .env.local » (en local) et remplis les valeurs.
# Sur Vercel : Settings > Environment Variables (mêmes noms).
# NE JAMAIS committer .env.local, NE JAMAIS partager ces clés.
# ---------------------------------------------------------------

# Adresse publique du site (sans slash final). Ex. https://2tijen.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé « service_role » : SECRÈTE, uniquement côté serveur.
SUPABASE_SERVICE_ROLE_KEY=

# --- SumUp (developer.sumup.com) : paiement en ligne ---
SUMUP_API_KEY=
# Code marchand, ex. MH4H92C7
SUMUP_MERCHANT_CODE=

# Facultatif : affiche tes dernières publications Instagram dans la galerie « Porté » (README, partie 2.7)
# INSTAGRAM_ACCESS_TOKEN=

# --- Resend (API Keys) ---
RESEND_API_KEY=re_

# --- Espace /admin : choisis un mot de passe long et unique ---
ADMIN_PASSWORD=
# Chaîne aléatoire (32+ caractères) qui signe le cookie de connexion admin.
ADMIN_SESSION_SECRET=

# --- Tests en local UNIQUEMENT (ignoré en production) ---
# Simule une date pour voir les états avant / accès anticipé / ouvert / clos.
# NOW_OVERRIDE=2026-10-13T10:00:00-04:00
